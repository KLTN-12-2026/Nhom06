# Sao chép thành .env rồi sửa. KHÔNG commit file .env.

# PostgreSQL
POSTGRES_DB=kho_ai
POSTGRES_USER=kho_ai
POSTGRES_PASSWORD=kho_ai_dev

# Cổng trên máy host
DB_PORT=5432
API_PORT=3000
WEB_PORT=5173
ML_PORT=8000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Mật khẩu tài khoản demo khi chạy `npx prisma db seed` (mặc định 123456 nếu để trống)
SEED_DEMO_PASSWORD=123456

# ML (timeout cho mỗi yêu cầu gọi dịch vụ dự báo, mặc định 10000 ms)
ML_TIMEOUT_MS=10000

# LLM (để none khi chưa có key: hệ thống dùng tóm tắt do bộ quy tắc sinh)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
