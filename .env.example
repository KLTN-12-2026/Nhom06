# Sao chép thành .env rồi sửa. KHÔNG commit file .env.

# PostgreSQL
POSTGRES_DB=kho_ai
POSTGRES_TEST_DB=kho_ai_test
POSTGRES_USER=kho_ai
POSTGRES_PASSWORD=kho_ai_dev
# URL DB test cho service api trong Docker Compose (dùng host db:5432; đổi sang localhost:${DB_PORT} nếu chạy jest trên máy host)
TEST_DATABASE_URL=postgresql://kho_ai:kho_ai_dev@db:5432/kho_ai_test?schema=public

# Cổng trên máy host
DB_PORT=5432
API_PORT=3000
WEB_PORT=5173
ML_PORT=8000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Mật khẩu tài khoản demo khi chạy `npx prisma db seed` (mặc định 123456 nếu để trống)
SEED_DEMO_PASSWORD=123456
# Chặn chạy `npm run seed:demo` ngoài môi trường dev; chỉ bật tường minh khi cần dựng dữ liệu demo
ALLOW_DEMO_SEED=false

# ML (timeout cho mỗi yêu cầu gọi dịch vụ dự báo, mặc định 10000 ms)
ML_TIMEOUT_MS=10000

# LLM (none = chỉ tóm tắt quy tắc; mock = giả lập tất định để demo; openai_compatible = API chuẩn OpenAI)
# Ví dụ cấu hình Gemini qua endpoint tương thích OpenAI (đặt khóa API vào .env cục bộ, KHÔNG commit):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=
#   LLM_MODEL=gemini-4-hydrogen
#   LLM_TIMEOUT_MS=60000
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
# Bật nút "Mô phỏng lỗi dịch vụ" / "Khôi phục dịch vụ diễn giải" trên màn hình chi tiết đề xuất khi demo
LLM_DEMO_TOGGLE=true

# Lịch đánh giá cảnh báo HSD hằng ngày (00:05 giờ Asia/Ho_Chi_Minh; đặt false khi chạy test)
EXPIRY_CRON_ENABLED=true

# Lịch phân tích rủi ro tồn dư hằng ngày (06:00 giờ Asia/Ho_Chi_Minh; đặt false khi chạy test)
ANALYSIS_CRON_ENABLED=true
# Tự động chạy phân tích nền sau khi xác nhận nhập/xuất kho (đặt false khi chạy test)
ANALYSIS_AUTO_ENABLED=true
# Thời gian gom (debounce, ms) cho nhiều biến động tồn liên tiếp (mặc định 30000 ms; đặt 0 khi chạy test)
ANALYSIS_AUTO_DEBOUNCE_MS=30000
